// $Id$
// vim:ft=javascript

ARG_ENABLE("pcov", "enable php coverage support", "no");

if (PHP_PCOV != "no") {
	if (PHP_VERSION < 8 || PHP_VERSION == 8 && PHP_MINOR_VERSION < 6) {
		ERROR("pcov requires PHP 8.6+");
	}

	EXTENSION("pcov", "pcov.c", PHP_PCOV_SHARED,
		"/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");
}
